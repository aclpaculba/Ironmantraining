# Copy this file to ".env" and fill in your key. Never commit .env.
DEEPSEEK_API_KEY=
# Model name. deepseek-chat was retired in July 2026. Check https://api-docs.deepseek.com for current names.
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: protects your key if you put the app on the internet. The app asks for it once.
APP_PASSCODE=
# Optional
PORT=3000

# Reminders (push notifications). Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. Protects /api/cron.
CRON_SECRET=
# Supabase project URL and the service_role key (Project Settings, API). Keep the key secret.
SUPABASE_URL=https://zqxnkqdqtwhldpgsiylm.supabase.co/rest/v1/
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpxeG5rcWRxdHdobGRwZ3NpeWxtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzU4ODE0NywiZXhwIjoyMTA5MTY0MTQ3fQ.nRngbpwvGrJIDV0keepPRycJP0E6CFBZdRQx2qiyw9A
